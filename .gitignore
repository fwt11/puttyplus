# 构建产物
/target

# deb 打包中间产物
/debian/files
/debian/debhelper-build-stamp
/debian/puttyplus
/debian/puttyplus.debhelper.log
/debian/puttyplus.substvars
/debian/.debhelper

# 打包出来的包（落在仓库根）
*.deb
*.changes
*.buildinfo

# 交付用的 release 可执行文件（放进仓库根的 release/，不进 git）
/release/

# C 版遗留的编译产物
*.o
puttyplus
test_follow

# Python 字节码（打包辅助脚本 import 时生成）
__pycache__/
*.pyc

# 编辑器与系统
*.swp
.DS_Store
